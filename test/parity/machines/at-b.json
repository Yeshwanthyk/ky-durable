{
  "schema": [
    "CREATE TABLE ky_tasks (\n      id TEXT PRIMARY KEY,\n      kind TEXT NOT NULL,\n      worker TEXT NOT NULL,\n      title TEXT NOT NULL,\n      status TEXT NOT NULL,\n      summary TEXT NOT NULL DEFAULT '',\n      session TEXT,\n      created_at INTEGER NOT NULL,\n      updated_at INTEGER NOT NULL, source TEXT NOT NULL DEFAULT 'chat', steps TEXT NOT NULL DEFAULT '[]', started_at INTEGER, finished_at INTEGER, turns INTEGER, cost_usd REAL, agent TEXT, chat TEXT)",
    "CREATE TABLE ky_task_steps (\n      seq INTEGER PRIMARY KEY,\n      task TEXT NOT NULL,\n      call TEXT,\n      at INTEGER NOT NULL,\n      ended_at INTEGER,\n      state TEXT NOT NULL,\n      text TEXT NOT NULL,\n      detail TEXT NOT NULL DEFAULT '',\n      input TEXT NOT NULL DEFAULT '',\n      output TEXT NOT NULL DEFAULT '')",
    "CREATE INDEX task_steps_by_task ON ky_task_steps (task, seq)",
    "CREATE TABLE ky_files (\n      id TEXT PRIMARY KEY,\n      task TEXT NOT NULL,\n      name TEXT NOT NULL,\n      type TEXT NOT NULL,\n      size INTEGER NOT NULL,\n      caption TEXT,\n      created_at INTEGER NOT NULL)",
    "CREATE TABLE ky_files_typed (done INTEGER NOT NULL)",
    "CREATE TABLE ky_sandboxes (\n      id TEXT PRIMARY KEY,\n      name TEXT NOT NULL,\n      repos TEXT NOT NULL DEFAULT '[]',\n      idle_minutes INTEGER,\n      is_default INTEGER NOT NULL DEFAULT 0,\n      created_at INTEGER NOT NULL,\n      deleted_at INTEGER)",
    "CREATE UNIQUE INDEX ky_sandboxes_live_name ON ky_sandboxes (name) WHERE deleted_at IS NULL",
    "CREATE TABLE ky_sandboxes_seeded (at INTEGER NOT NULL)",
    "CREATE TABLE ky_machine_inbox (\n      seq INTEGER PRIMARY KEY AUTOINCREMENT,\n      machine TEXT NOT NULL,\n      payload TEXT NOT NULL, sent INTEGER NOT NULL DEFAULT 0)",
    "CREATE TABLE sqlite_sequence(name,seq)",
    "CREATE TABLE ky_machines (\n      name TEXT PRIMARY KEY, seen_at INTEGER NOT NULL, state TEXT NOT NULL DEFAULT 'on', note TEXT NOT NULL DEFAULT '', facts TEXT, pairing TEXT, login TEXT NOT NULL DEFAULT 'own', hello TEXT, reason TEXT, turns_ended INTEGER NOT NULL DEFAULT 0)",
    "CREATE TABLE ky_machine_turns (\n      task TEXT PRIMARY KEY,\n      turn INTEGER NOT NULL,\n      closed INTEGER NOT NULL,\n      sent INTEGER NOT NULL, stopping INTEGER NOT NULL DEFAULT 0)",
    "CREATE TABLE ky_machine_senders (\n      task TEXT NOT NULL,\n      turn INTEGER NOT NULL,\n      session TEXT NOT NULL,\n      PRIMARY KEY (task, turn))",
    "CREATE TABLE ky_machine_logins (\n      task TEXT PRIMARY KEY,\n      expires_at INTEGER NOT NULL)",
    "CREATE TABLE ky_machine_reports (\n      task TEXT NOT NULL,\n      turn INTEGER NOT NULL,\n      session TEXT NOT NULL,\n      text TEXT NOT NULL,\n      PRIMARY KEY (task, turn, session))"
  ],
