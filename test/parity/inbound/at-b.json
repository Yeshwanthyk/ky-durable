  "schema": [
    "CREATE TABLE ky_approvals (\n      id TEXT PRIMARY KEY,\n      kind TEXT NOT NULL,\n      ref TEXT NOT NULL,\n      subject TEXT NOT NULL,\n      summary TEXT NOT NULL,\n      payload TEXT NOT NULL,\n      status TEXT NOT NULL,\n      conversation TEXT NOT NULL,\n      chat TEXT NOT NULL,\n      created_at INTEGER NOT NULL,\n      decided_at INTEGER,\n      carried_at INTEGER,\n      UNIQUE (kind, ref))",
    "CREATE TABLE ky_hook_seen (\n      hook TEXT NOT NULL,\n      key TEXT NOT NULL,\n      at INTEGER NOT NULL,\n      PRIMARY KEY (hook, key))",
    "CREATE TABLE ky_hooks (\n      id TEXT PRIMARY KEY,\n      session TEXT NOT NULL,\n      label TEXT NOT NULL,\n      signed INTEGER NOT NULL,\n      created_at INTEGER NOT NULL,\n      last_at INTEGER)",
    "CREATE TABLE ky_passes (\n      approval TEXT PRIMARY KEY,\n      at INTEGER NOT NULL)",
    "CREATE TABLE ky_secret_asks (\n      session TEXT NOT NULL,\n      name TEXT NOT NULL,\n      origin TEXT NOT NULL,\n      scheme TEXT NOT NULL,\n      header TEXT,\n      purpose TEXT NOT NULL,\n      at INTEGER NOT NULL,\n      PRIMARY KEY (session, name))",
    "CREATE TABLE pi_submissions (id INTEGER PRIMARY KEY, conversation_id INTEGER NOT NULL, status TEXT NOT NULL, record TEXT NOT NULL)",
    "CREATE INDEX ky_approvals_pending ON ky_approvals (status, created_at)"
  ],
