{
  "at": 1792922400000,
  "schema": [
    "CREATE TABLE ky_tasks (\n      id TEXT PRIMARY KEY,\n      kind TEXT NOT NULL,\n      worker TEXT NOT NULL,\n      title TEXT NOT NULL,\n      status TEXT NOT NULL,\n      summary TEXT NOT NULL DEFAULT '',\n      session TEXT,\n      created_at INTEGER NOT NULL,\n      updated_at INTEGER NOT NULL, source TEXT NOT NULL DEFAULT 'chat', steps TEXT NOT NULL DEFAULT '[]', started_at INTEGER, finished_at INTEGER, turns INTEGER, cost_usd REAL, agent TEXT, chat TEXT)",
    "CREATE TABLE ky_task_steps (\n      seq INTEGER PRIMARY KEY,\n      task TEXT NOT NULL,\n      call TEXT,\n      at INTEGER NOT NULL,\n      ended_at INTEGER,\n      state TEXT NOT NULL,\n      text TEXT NOT NULL,\n      detail TEXT NOT NULL DEFAULT '',\n      input TEXT NOT NULL DEFAULT '',\n      output TEXT NOT NULL DEFAULT '')",
    "CREATE TABLE ky_chats (\n      session TEXT PRIMARY KEY,\n      title TEXT NOT NULL DEFAULT '',\n      created_at INTEGER NOT NULL,\n      updated_at INTEGER NOT NULL, archived_at INTEGER, opened_by TEXT, opened_request TEXT)",
    "CREATE TABLE ky_main_chat (\n      id INTEGER PRIMARY KEY CHECK (id = 1),\n      updated_at INTEGER NOT NULL)",
    "CREATE TABLE ky_check_ins (id INTEGER PRIMARY KEY CHECK (id = 1), off INTEGER NOT NULL, zone TEXT, zone_pinned INTEGER NOT NULL DEFAULT 0)",
    "CREATE TABLE ky_automations (\n      id TEXT PRIMARY KEY,\n      title TEXT NOT NULL,\n      prompt TEXT NOT NULL,\n      cron TEXT,\n      at INTEGER,\n      model TEXT,\n      machine TEXT,\n      chat TEXT NOT NULL,\n      gate TEXT,\n      gate_checked_at INTEGER,\n      gate_note TEXT,\n      gate_errors INTEGER NOT NULL DEFAULT 0,\n      gate_found TEXT,\n      gate_found_by TEXT,\n      watch INTEGER,\n      post INTEGER NOT NULL DEFAULT 0,\n      created_by TEXT NOT NULL,\n      status TEXT NOT NULL,\n      schedule_id TEXT,\n      created_at INTEGER NOT NULL,\n      updated_at INTEGER NOT NULL, zone TEXT DEFAULT 'UTC')"
  ],
