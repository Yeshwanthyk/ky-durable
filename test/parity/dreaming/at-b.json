{
  "at": 1790939532000,
  "schema": [
    "CREATE TABLE ky_skills (\n      name TEXT PRIMARY KEY,\n      description TEXT NOT NULL,\n      body TEXT NOT NULL,\n      status TEXT NOT NULL DEFAULT 'active',\n      uses INTEGER NOT NULL DEFAULT 0,\n      created_at INTEGER NOT NULL,\n      updated_at INTEGER NOT NULL\n    , last_used_at INTEGER, pinned INTEGER NOT NULL DEFAULT 0, created_by TEXT NOT NULL DEFAULT 'user', answers TEXT, kind TEXT NOT NULL DEFAULT 'skill')",
    "CREATE TABLE ky_skill_versions (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      name TEXT NOT NULL,\n      action TEXT NOT NULL,\n      actor TEXT NOT NULL,\n      description TEXT NOT NULL,\n      body TEXT NOT NULL,\n      status TEXT NOT NULL,\n      created_at INTEGER NOT NULL\n    , conversation TEXT)",
    "CREATE TABLE sqlite_sequence(name,seq)",
    "CREATE TABLE ky_skill_reviews (\n      conversation TEXT PRIMARY KEY,\n      parent TEXT NOT NULL,\n      created_at INTEGER NOT NULL\n    , kind TEXT NOT NULL DEFAULT 'review', upto INTEGER, run TEXT)",
    "CREATE INDEX skill_reviews_by_parent ON ky_skill_reviews (parent, kind)",
    "CREATE TABLE memo_log (\n      id INTEGER PRIMARY KEY, date TEXT NOT NULL, text TEXT NOT NULL)",
    "CREATE TABLE memo_tree (\n      lo INTEGER NOT NULL, hi INTEGER NOT NULL, text TEXT NOT NULL,\n      PRIMARY KEY (lo, hi))",
    "CREATE TABLE ky_specialists (\n    id TEXT PRIMARY KEY,\n    description TEXT NOT NULL,\n    model TEXT,\n    machine TEXT,\n    session TEXT,\n    created_at INTEGER NOT NULL)",
    "CREATE TABLE ky_specialist_sessions (\n    session TEXT PRIMARY KEY,\n    specialist TEXT NOT NULL,\n    kind TEXT NOT NULL,\n    created_at INTEGER NOT NULL)",
    "CREATE TABLE ky_soul_versions (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      action TEXT NOT NULL,\n      actor TEXT NOT NULL,\n      conversation TEXT,\n      body TEXT NOT NULL,\n      created_at INTEGER NOT NULL\n    , key TEXT NOT NULL DEFAULT 'soul', version INTEGER)",
    "CREATE TABLE ky_dream_ledger (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      run TEXT NOT NULL,\n      kind TEXT NOT NULL,\n      action TEXT NOT NULL,\n      target TEXT NOT NULL,\n      before,\n      reason TEXT,\n      absorbed_into TEXT,\n      at INTEGER NOT NULL,\n      undone_at INTEGER\n    , actor TEXT, after INTEGER)"
  ],
