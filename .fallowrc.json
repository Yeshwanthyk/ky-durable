{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "public/sw.js",
    "cli/binary.ts",
    "cli/main.ts",
    "test/fakes/claude.ts",
    "test/fakes/codex.ts",
    "test/web/global-setup.ts",
    "src/tests/stack-built.ts",
    "test/web/outcomes.ts",
    "test/gate.ts",
    "test/gate-live.ts",
    "test/effect-pin.ts"
  ],
  "ignorePatterns": [
    "explainers/**",
    "test-results/**",
    "tools/oxlint/anti-slop/vendor/**",
    "vendor/**"
  ],
  "ignoreUnresolvedImports": [
    "../dist/release.pack"
  ],
  "dynamicallyLoaded": [
    "cli/commands.ts",
    "cli/backup.ts",
    "cli/login.ts",
    "cli/runner/commands.ts"
  ],
  "ignoreDependencies": [
    "@earendil-works/pi-telemetry"
  ],
  "usedClassMembers": [
    {
      "extends": "DurableObject",
      "members": [
        "*"
      ]
    },
    {
      "extends": "WorkerEntrypoint",
      "members": [
        "*"
      ]
    },
    {
      "implements": "Refusable",
      "members": [
        "refusal"
      ]
    }
  ]
}
