{
  // Copy to wrangler.local.jsonc (gitignored) and fill in what you use. vite.config.ts merges it over
  // wrangler.jsonc for `pnpm start` and `pnpm run deploy`: vars merge, VPC services are added, and anything else
  // replaces wrangler.jsonc's. Anything left out shows as "Not set up" in Settings. Secrets stay secrets:
  // see .dev.vars.example.
  "vars": {
    // ky's own email address, on a domain onboarded in Email Service › Email Sending, with an Email Routing rule
    // sending it to this Worker. Needs the EMAIL binding below.
    // "KY_MAIL_ADDRESS": "ky@example.com",
    // How many mails ky sends a day (50) and reads an hour (20); the rest are kept, unread, in Settings › Mail.
    // "KY_MAIL_DAILY_SENDS": "50",
    // "KY_MAIL_HOURLY_TRIAGES": "20"
  },
  // Sends ky's mail from KY_MAIL_ADDRESS (Email Service).
  // "send_email": [{ "name": "EMAIL", "remote": true }]
  // A custom domain, if you have one:
  // "routes": [{ "pattern": "ky.example.com", "custom_domain": true }]
}
