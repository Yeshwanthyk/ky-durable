{
  // The code that runs in Node rather than the Worker: the `ky` CLI, the machine runner,
  // the release's scripts, the build's config, and the gate's harnesses, fakes and Playwright suite. `pnpm typecheck`
  // checks it after the Worker's tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "@cloudflare/workers-types"],
    "erasableSyntaxOnly": true,
    // cli/binary.ts embeds the release with an import attribute.
    "module": "esnext"
  },
  "include": ["cli/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "src/tests/frames.ts", "src/tests/fake-access.ts", "vite.config.ts", "wrangler-overlay.ts", "env.d.ts", "env.optional.d.ts"]
}
