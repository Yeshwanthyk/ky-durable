{
  // The local stack and the worker e2e tests: ky's real Worker and PiAgent,
  // whose src/tests/stack.ts subclass puts fakes at the outside boundary
  // (models, VibeProxy, Browser Rendering, Executor). So the remote bindings,
  // BROWSER and VIBEPROXY, are left out.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ky-stack",
  "main": "stack.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ky-files-stack" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Access's team, app and owner, as src/tests/fake-access.ts signs for them.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ky-test.cloudflareaccess.com",
    "ACCESS_AUD": "ky-test-aud",
    "ACCESS_EMAILS": "owner@ky.test"
  },
  // Pairing is open to anyone: at most 10 attempts a minute from one address (src/runners.ts).
  "ratelimits": [{ "name": "PAIR_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "durable_objects": {
    "bindings": [
      { "name": "PiAgent", "class_name": "PiAgent" },
      { "name": "Vault", "class_name": "Vault" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PiAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Vault"] }
  ]
}
