{
  "name": "ky",
  "description": "Personal durable agent",
  "private": true,
  "type": "module",
  "version": "0.2.5",
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "types": "wrangler types env.d.ts --include-runtime false --env-file .dev.vars.example",
    "test": "vitest run --config src/tests/vitest.config.ts",
    "test:node": "vitest run --config test/node/vitest.config.ts",
    "lint": "oxlint",
    "stack": "vite dev --config test/stack/vite.config.ts",
    "harness": "node --experimental-strip-types --no-warnings test/harness/main.ts",
    "test:web": "playwright test --config test/web/playwright.config.ts",
    "gate": "node --experimental-strip-types --no-warnings test/gate.ts",
    "gate:live": "node --experimental-strip-types --no-warnings test/gate-live.ts",
    "live:cloud": "node --experimental-strip-types --no-warnings test/live-cloud.ts",
    "compile": "vite build && node --experimental-strip-types --no-warnings cli/compile.ts",
    "ky": "node --experimental-strip-types --no-warnings cli/main.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@cloudflare/computer": "^0.4.0",
    "@cloudflare/playwright": "^1.3.6",
    "@distilled.cloud/cloudflare": "1.0.0-rc.12",
    "@distilled.cloud/core": "1.0.0-rc.12",
    "@earendil-works/chord": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-durable": "^1.0.0",
    "@earendil-works/pi-telemetry": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@pierre/diffs": "^1.5.2",
    "@platformatic/vfs": "^0.4.0",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.26.0",
    "effect": "4.0.0-rc.117",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "typebox": "1.3.27",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "26.6.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "1.86.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "4.1.11",
    "wrangler": "^4.145.0",
    "ws": "8.22.0",
    "zod": "^4.5.4"
  }
}
