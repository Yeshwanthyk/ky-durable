{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Generic: what any deploy needs. The owner's vars and bindings (VibeProxy's tunnel, Executor) go in
  // wrangler.local.jsonc, which vite.config.ts merges in when present; see wrangler.local.example.jsonc.
  "name": "ky",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  // Which deploy is serving; open pages reload when it changes.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Screenshots and recordings machine tasks share (src/files.ts).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ky-files" }],
  // Browser Rendering, for the `browse` tool's Kitesurf browser.
  "browser": { "binding": "BROWSER", "remote": true },
  // `exec` runs JavaScript in Dynamic Workers minted through this.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Workers AI: models that need no key.
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker, which signs the user in.
    "run_worker_first": true
  },
  // Pairing is open to anyone: at most 10 attempts a minute from one address (src/runners.ts).
  "ratelimits": [{ "name": "PAIR_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      },
      {
        // Every secret ky keeps, and the tokens it hands out (src/vault.ts).
        "name": "Vault",
        "class_name": "Vault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Vault"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
