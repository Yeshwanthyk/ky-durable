{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ky",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  // Which deploy is serving; open pages reload when it changes.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Screenshots and recordings machine tasks share (src/files.ts).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ky-files" }],
  // `exec` runs JavaScript in Dynamic Workers minted through this.
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker, which signs the user in.
    "run_worker_first": true
  },
  "vars": {
    // Executor's MCP endpoint for the organization, with approvals in the browser.
    "EXECUTOR_URL": "https://v2.executor.sh/org/presh/mcp?elicitation_mode=browser",
    // The OpenCode Go model for subagents, and for the main agent while Claude is away.
    "KY_MODEL": "deepseek-v4.1-flash"
  },
  // The Mac's VibeProxy, reached only through a private tunnel (no public hostname).
  "vpc_services": [
    {
      "binding": "VIBEPROXY",
      "service_id": "01a1072f-6f9d-7400-be66-5286e94898a1",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
